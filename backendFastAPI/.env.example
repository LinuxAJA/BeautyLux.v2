# App
ENVIRONMENT=development
PORT=8000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# Base de datos (se reusa la misma BD que el backend Node)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_beautylux_v2
DB_CONNECTION_LIMIT=10

# JWT (usar el MISMO valor de JWT_ACCESS_SECRET que backend/.env para que
# los tokens sean intercambiables entre los dos backends)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=beautylux-api
JWT_AUDIENCE=beautylux-web

# Seguridad / TTL
BCRYPT_ROUNDS=12
REFRESH_TTL_DAYS=7
REFRESH_TTL_REMEMBER_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# false una vez el correo de recuperación funcione (MAIL_ENABLED=true más abajo);
# true solo como respaldo para probar el flujo sin bandeja de correo.
EXPOSE_RESET_TOKEN=true

# Frontend — para construir el enlace del correo de recuperación
FRONTEND_URL=http://localhost:5173

# Correo (SMTP). Con MAIL_ENABLED=false no se envía nada: el enlace queda en el log.
# Mailtrap Sandbox (https://mailtrap.io → Email Testing → tu inbox → pestaña Integration):
MAIL_ENABLED=false
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BeautyLux <no-reply@beautylux.com>
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
