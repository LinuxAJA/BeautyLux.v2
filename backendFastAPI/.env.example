# App
ENVIRONMENT=development
PORT=8000
API_PREFIX=/api
# Uno o varios orígenes separados por coma.
CORS_ORIGIN=http://localhost:5173

# Cookie de refresh. En local, lax sin Secure. En producción (Vercel + Render,
# dominios distintos): COOKIE_SAMESITE=none y COOKIE_SECURE=true.
# Sin COOKIE_SECURE, Secure se activa solo cuando ENVIRONMENT=production.
COOKIE_SAMESITE=lax

# Base de datos (se reusa la misma BD que el backend Node)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_beautylux_v2
DB_CONNECTION_LIMIT=10
# Ruta al certificado CA para conectar por TLS (Aiven). Vacía en local.
DB_SSL_CA=

# JWT (usar el MISMO valor de JWT_ACCESS_SECRET que backend/.env para que
# los tokens sean intercambiables entre los dos backends)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=beautylux-api
JWT_AUDIENCE=beautylux-web

# Seguridad / TTL
BCRYPT_ROUNDS=12
REFRESH_TTL_DAYS=7
REFRESH_TTL_REMEMBER_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# false una vez el correo de recuperación funcione (MAIL_ENABLED=true más abajo);
# true solo como respaldo para probar el flujo sin bandeja de correo.
EXPOSE_RESET_TOKEN=true

# Frontend — para construir el enlace del correo de recuperación
FRONTEND_URL=http://localhost:5173

# Correo (SMTP). Con MAIL_ENABLED=false no se envía nada: el enlace queda en el log.
# Mailtrap Sandbox (https://mailtrap.io → Email Testing → tu inbox → pestaña Integration):
MAIL_ENABLED=false
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=BeautyLux <no-reply@beautylux.com>
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10

# Datos del negocio para la cabecera de facturas y reportes (etapas 7 y 8).
# Los valores por defecto ya coinciden con el pie de pagina del frontend;
# solo hace falta tocarlos si el negocio cambia de nombre o de domicilio.
BUSINESS_NAME=BeautyLux
BUSINESS_NIT=900.123.456-7
BUSINESS_ADDRESS=Calle 45 #23-18, Barrio La Castellana, Bogota D.C.
BUSINESS_PHONE=+57 320 456 7890
BUSINESS_EMAIL=hola@beautylux.com

# Chatbot con IA (etapa 12). Sin GEMINI_API_KEY o con AI_ENABLED=false, el
# chat responde igual con un FAQ local de respaldo: nunca se cae en la
# sustentación por falta de credenciales. Este archivo se versiona vacío a
# propósito (requisito 19): la API Key real solo va en tu .env, que está en
# .gitignore.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_ENABLED=false
