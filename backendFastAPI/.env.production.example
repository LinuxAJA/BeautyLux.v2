# Plantilla de variables para PRODUCCIÓN (Render + MySQL en Aiven).
# No se usa como archivo: sus valores se cargan en Render > Environment. render.yaml ya fija los
# que no son secretos; los vacíos de abajo se completan a mano y nunca se versionan con valor.

ENVIRONMENT=production
API_PREFIX=/api
# Render inyecta PORT solo; no hace falta definirlo.

# Dominio público de Vercel. Varios orígenes separados por coma (p. ej. los previews):
CORS_ORIGIN=https://beautylux.vercel.app
FRONTEND_URL=https://beautylux.vercel.app

# Frontend y API en dominios distintos: la cookie de refresh necesita SameSite=None + Secure.
COOKIE_SAMESITE=none
COOKIE_SECURE=true

# MySQL gestionado en Aiven (Overview > Connection information).
DB_HOST=
DB_PORT=
DB_USER=avnadmin
DB_PASSWORD=
# Los scripts de database/ hacen USE de este nombre: no lo cambies.
DB_NAME=db_beautylux_v2
# Aiven exige TLS. El ca.pem se sube a Render como Secret File y queda en esta ruta.
DB_SSL_CA=/etc/secrets/ca.pem
DB_CONNECTION_LIMIT=5

# Secreto largo y aleatorio (render.yaml lo genera solo con generateValue).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=beautylux-api
JWT_AUDIENCE=beautylux-web

BCRYPT_ROUNDS=12
REFRESH_TTL_DAYS=7
REFRESH_TTL_REMEMBER_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
# Nunca true en producción: expondría el token de recuperación en la respuesta.
EXPOSE_RESET_TOKEN=false

# Correo con Brevo. render.yaml fija host, puerto y seguridad; lo demás va en el panel.
# Render free bloquea la salida a 25, 465 y 587: por eso el puerto es 2525.
# Con MAIL_ENABLED=true el arranque exige SMTP_USER, SMTP_PASSWORD y SMTP_FROM.
MAIL_ENABLED=true
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=2525
SMTP_SECURITY=starttls
# Brevo > SMTP & API > SMTP: login SMTP y clave SMTP (no la API key).
SMTP_USER=
SMTP_PASSWORD=
# Remitente verificado en Brevo > Senders. Brevo reescribe un Gmail a @brevosend.com.
SMTP_FROM=BeautyLux <tu-correo@gmail.com>
MAIL_REPLY_TO=tu-correo@gmail.com

# Chatbot con Google Gemini. La clave solo vive en el panel de Render.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_ENABLED=true
