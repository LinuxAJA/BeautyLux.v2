# Plantilla de variables para PRODUCCIÓN (Vercel > Project > Settings > Environment Variables).
# Vite las incrusta en el build: cambiarlas exige volver a desplegar.

# URL pública del backend en Render, terminada en /api.
VITE_API_URL=https://beautylux-api.onrender.com/api

# Número de WhatsApp (formato internacional, sin "+" ni espacios).
VITE_WHATSAPP_NUMBER=573001234567
