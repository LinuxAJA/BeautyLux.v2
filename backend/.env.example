NODE_ENV=development
PORT=3000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_beautylux_v2
DB_CONNECTION_LIMIT=10

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_ISSUER=beautylux-api
JWT_AUDIENCE=beautylux-web

BCRYPT_ROUNDS=12
REFRESH_TTL_DAYS=7
REFRESH_TTL_REMEMBER_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EXPOSE_RESET_TOKEN=true
