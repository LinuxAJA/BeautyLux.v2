{
  "name": "backend",
  "version": "1.0.0",
  "description": "API REST de BeautyLux — Node.js + Express + MySQL 8. Arquitectura por capas (routes, middlewares, controllers, services, repositories, models, utils) con patrón Singleton para la conexión a base de datos, Repository Pattern y Service Layer.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:ping": "node database/run.mjs ping",
    "db:schema": "node database/run.mjs schema",
    "db:seed": "node database/run.mjs seed",
    "db:reset": "node database/run.mjs reset",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "beautylux",
    "express",
    "mysql",
    "jwt",
    "rest-api"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.2",
    "zod": "^4.1.13"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
